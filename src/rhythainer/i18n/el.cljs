(ns rhythainer.i18n.el)

(def ^:private cheers
  {3 ["Εξαιρετικά!!" "Μπράβο!" "Τέλεια!" "Υπέροχα!"]
   2 ["Πολύ καλά!" "Ωραία δουλειά!" "Μπράβο σου!" "Ωραία!"]
   1 ["Καλή προσπάθεια!" "Πας καλά!" "Σχεδόν!" "Συνέχισε έτσι!"]
   0 ["Παραλίγο! Ξαναδοκίμασε" "Συνέχισε!" "Πάμε άλλη μια φορά!" "Θα τα καταφέρεις!"]})

(def ^:private session-cheers
  {3 ["Εξαιρετικά!! Είσαι αστέρι του ρυθμού!" "Μπράβο! Υπέροχος γύρος!" "Τέλειος χρόνος, μπράβο!" "Καταπληκτικά!"]
   2 ["Πολύ καλός γύρος!" "Πολύ καλή δουλειά!" "Μπράβο, ωραίος ρυθμός!" "Ωραία δουλειά!"]
   1 ["Καλή προσπάθεια! Συνέχισε την εξάσκηση" "Γίνεσαι όλο και καλύτερος!" "Ωραία, συνέχισε!" "Καλή προσπάθεια!"]
   0 ["Συνέχισε την εξάσκηση, θα τα καταφέρεις!" "Κάθε προσπάθεια σε κάνει καλύτερο!" "Πάμε πάλι!" "Μην τα παρατάς!"]})

(defn- n-of [n one many] (str n " " (if (= n 1) one many)))

